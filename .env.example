# Copy to .env.local and fill in. Never commit .env.local.
# Anything left empty runs on a local stand-in, so the agent always starts.

# Local model server, OpenAI-compatible. Nothing here ever points at a cloud LLM.
#   Ollama (laptop or GB10): ollama serve                      -> http://localhost:11434/v1
#   vLLM on Dell Pro Max GB10: vllm serve nvidia/NVIDIA-Nemotron-Nano-9B-v2 --port 8000 -> http://localhost:8000/v1
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5:3b
# On a Dell Pro Max GB10 (128 GB unified memory) use a bigger model, e.g. qwen2.5:32b or Nemotron Nano 9B v2
# Set to 0 to force the deterministic rule engine (no model at all).
AI_ENABLED=1

# Escalation channels (optional). Without them, alerts go to the console feed on the dashboard.
# Telegram: talk to @BotFather, create a bot, then get your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack: an Incoming Webhook URL
SLACK_WEBHOOK_URL=

# How often the always-on loop checks the inbox, in seconds
POLL_SECONDS=10
# Local time of the morning brief (24h)
BRIEF_AT=08:00

PORT=8791
